# Copy this file to `.env` in the frontend/ directory and adjust as needed.

# Full WebSocket URL for live transcription. Leave unset for local dev —
# it will default to ws://<current-hostname>:8000/ws/transcribe.
# Set this explicitly when the backend runs on a different host, e.g.
# a remote server for a packaged desktop/mobile build:
# VITE_WS_URL=wss://your-backend.example.com/ws/transcribe

# Used only when VITE_WS_URL is not set, to build the default local dev URL.
# VITE_BACKEND_PORT=8000