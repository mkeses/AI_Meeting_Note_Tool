# Copy this file to `.env` in the frontend/ directory and adjust as needed.

# WebSocket host/base URL or full endpoint for live transcription. The
# /ws/transcribe path is appended to a base URL. Leave unset for local dev —
# it will default to ws://<current-hostname>:8000/ws/transcribe.
# Use ws:// or wss:// when the backend runs on a different host, e.g.:
# VITE_WS_URL=wss://your-backend.example.com

# Used only when VITE_WS_URL is not set, to build the default local dev URL.
# VITE_BACKEND_PORT=8000
