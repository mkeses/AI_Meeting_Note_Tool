# Production-like remote backend configuration. Copy to .env.production and
# replace every CHANGE_ME value with a deployment secret or provider value.

APP_ENV=production

# Public HTTPS host served by the reverse proxy. The certificate must match it.
PUBLIC_HOST=app.example.com

# PostgreSQL service configuration. POSTGRES_PASSWORD is a secret.
POSTGRES_DB=meeting_notes
POSTGRES_USER=meeting_app
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES_DATABASE_URL=postgresql://meeting_app:CHANGE_ME_DATABASE_PASSWORD@database:5432/meeting_notes
MEETING_STORAGE_BACKEND=postgresql

# Authenticated remote workspace. AUTH_SESSION_SECRET is a secret of at least
# 32 characters. Keep secure cookies enabled behind HTTPS.
AUTH_ENABLED=1
AUTH_SESSION_SECRET=CHANGE_ME_SESSION_SECRET_AT_LEAST_32_CHARACTERS
AUTH_COOKIE_SECURE=1
AUTH_SESSION_LIFETIME_SECONDS=86400
REMOTE_CORS_ORIGINS=https://app.example.com

# Faster-Whisper remains CPU/int8. The model cache is persisted in Docker.
WHISPER_MODEL=base.en

# External OpenAI-compatible LLM provider. LLM_API_KEY is a secret when the
# provider requires one; it may be omitted for a compatible local provider.
LLM_BASE_URL=https://llm.example.com/v1
LLM_API_KEY=CHANGE_ME_LLM_API_KEY
LLM_MODEL=meeting-model
LLM_TIMEOUT_SECONDS=30
