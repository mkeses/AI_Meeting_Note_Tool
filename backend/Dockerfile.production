FROM ghcr.io/astral-sh/uv:0.12.1 AS uv

FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive \
    HF_HOME=/home/app/.cache/huggingface \
    HOME=/home/app \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH

RUN apt-get update \
    && apt-get install --no-install-recommends --yes libgomp1 util-linux \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 app \
    && useradd --create-home --uid 10001 --gid app --shell /usr/sbin/nologin app

COPY --from=uv /uv /uvx /usr/local/bin/

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project --extra postgres --extra auth

COPY --chown=app:app \
    app.py \
    auth.py \
    auth_models.py \
    database.py \
    llm.py \
    meeting_entity.py \
    meeting_models.py \
    postgres_database.py \
    settings.py \
    storage.py \
    system_prompt.txt \
    transcription.py \
    user_entity.py \
    ./

COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod 755 /usr/local/bin/docker-entrypoint.sh \
    && mkdir -p "$HF_HOME" /data \
    && chown -R app:app /home/app/.cache /data

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=5m --retries=3 CMD ["python", "-c", "from urllib.request import urlopen; urlopen('http://127.0.0.1:8000/api/ready', timeout=3).read()"]

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000", "--timeout-keep-alive", "600"]
