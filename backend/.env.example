# LLM API Configuration (OpenAI-compatible)
# This app works with ANY OpenAI API-compatible provider!

# Ollama or another local OpenAI-compatible provider
LLM_BASE_URL=http://ollama:11434/v1
# Optional for local Ollama and other providers that do not require a key.
# Do not put a production provider key in this example file.
# LLM_API_KEY=ollama
LLM_MODEL=gemma3:4b
LLM_TIMEOUT_SECONDS=30

# Examples for other providers:
# LM Studio: LLM_BASE_URL=http://localhost:1234/v1, LLM_API_KEY=lm-studio, LLM_MODEL=your-model

# Whisper Configuration (local speech-to-text)
WHISPER_MODEL=base.en

# Persistent meeting storage (local development path)
DATABASE_PATH=./data/meetings.db

# Remote API only: comma-separated, exact browser origins allowed to make
# credentialed requests. Keep unset for the local desktop/browser defaults.
# REMOTE_CORS_ORIGINS=https://app.example.com

# Production deployment uses .env.production (created from
# .env.production.example), not this local-development file.
